# EHN One - Environment Configuration Template
# Copy to .env and fill in values

# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ehnone?retryWrites=true&w=majority

# Authentication (generate a strong random secret)
JWT_SECRET=your-random-64-char-secret-here
JWT_EXPIRE=7d

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS=https://admin.kedvasshygieneproducts.com

# Rate Limiting
RATE_LIMIT_MAX=100

# WhatsApp Business API (optional)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Email SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
